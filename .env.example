# =============================================================================
# LLM API Keys
# =============================================================================
# For multi-AI collaboration, configure all three providers:
# - Claude (Anthropic): Strategic planning and brand consistency
# - ChatGPT (OpenAI): Creative content generation
# - Gemini (Google): Refinement and optimization

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
ORCHESTRATOR_MODEL=gpt-4-turbo-preview
AGENT_MODEL=gpt-4-turbo-preview

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITERATIONS=10
MEMORY_PERSISTENCE=true

# =============================================================================
# Social Media Deployment Configuration
# =============================================================================

# Master Deployment Switches
DEPLOYMENT_ENABLED=true
DEPLOYMENT_CHANNELS=instagram,tiktok
DEPLOYMENT_DRY_RUN=false

# Instagram Business Account (via Facebook Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_IG_USER_ID=your_instagram_business_user_id
INSTAGRAM_IMAGE_URL=https://example.com/default-image.jpg

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_VIDEO_URL=https://example.com/default-video.mp4

# Facebook Page (optional - if also posting to Facebook)
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# X/Twitter API (optional - OAuth 1.0a)
X_API_KEY=your_twitter_consumer_key
X_API_SECRET=your_twitter_consumer_secret
X_ACCESS_TOKEN=your_twitter_access_token
X_ACCESS_SECRET=your_twitter_access_token_secret

# Telegram Notifications (optional - for alerts)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=987654321

# Email Notifications (optional - SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=notifications@yourdomain.com

# Blog/WordPress (optional)
WORDPRESS_BASE_URL=https://yourblog.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=abcd efgh ijkl mnop
BLOG_POST_STATUS=draft
