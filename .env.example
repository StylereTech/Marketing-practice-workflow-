# =============================================================================
# SECRETS MANAGEMENT CONFIGURATION
# =============================================================================
# Choose your secrets provider: env (local), aws, azure, or gcp
# For production, use a cloud secrets manager (aws/azure/gcp)
# For local development, use 'env' (default)
SECRETS_PROVIDER=env

# AWS Secrets Manager Configuration (if using SECRETS_PROVIDER=aws)
# AWS_DEFAULT_REGION=us-east-1
# AWS credentials should be configured via AWS CLI or IAM roles

# Azure Key Vault Configuration (if using SECRETS_PROVIDER=azure)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Azure credentials should be configured via Azure CLI or managed identity

# Google Cloud Secret Manager Configuration (if using SECRETS_PROVIDER=gcp)
# GCP_PROJECT_ID=your-project-id
# GCP credentials should be configured via gcloud CLI or service account

# =============================================================================
# LLM API KEYS
# =============================================================================
# If using SECRETS_PROVIDER=env, set keys here
# If using cloud provider, store these in your secrets manager
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
ORCHESTRATOR_MODEL=gpt-4-turbo-preview
AGENT_MODEL=gpt-4-turbo-preview

# =============================================================================
# SOCIAL MEDIA OAUTH CONFIGURATION
# =============================================================================
# Instagram Business Account
# Store OAuth tokens in secrets manager using the OAuth manager
# INSTAGRAM_IG_USER_ID=your_instagram_user_id
# OAuth credentials should be stored as INSTAGRAM_OAUTH_TOKEN (JSON)
# OAuth app credentials should be stored as INSTAGRAM_OAUTH_CREDENTIALS (JSON)

# Facebook Page
# FACEBOOK_PAGE_ID=your_facebook_page_id
# OAuth credentials should be stored as FACEBOOK_OAUTH_TOKEN (JSON)
# OAuth app credentials should be stored as FACEBOOK_OAUTH_CREDENTIALS (JSON)

# Google APIs (YouTube, Analytics, etc.)
# OAuth credentials should be stored as GOOGLE_OAUTH_TOKEN (JSON)
# OAuth app credentials should be stored as GOOGLE_OAUTH_CREDENTIALS (JSON)

# =============================================================================
# X/TWITTER CREDENTIALS
# =============================================================================
# X_API_KEY=your_x_api_key
# X_API_SECRET=your_x_api_secret
# X_ACCESS_TOKEN=your_x_access_token
# X_ACCESS_SECRET=your_x_access_secret

# =============================================================================
# TELEGRAM BOT
# =============================================================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# EMAIL/SMTP CONFIGURATION
# =============================================================================
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# =============================================================================
# WORDPRESS BLOG
# =============================================================================
# WORDPRESS_BASE_URL=https://your-blog.com
# WORDPRESS_USERNAME=your_username
# WORDPRESS_APP_PASSWORD=your_wordpress_app_password
# BLOG_POST_STATUS=draft

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
DEPLOYMENT_ENABLED=true
DEPLOYMENT_DRY_RUN=false
DEPLOYMENT_CHANNELS=email,telegram

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITERATIONS=10
MEMORY_PERSISTENCE=true
