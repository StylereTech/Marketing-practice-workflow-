  "messaging_examples": {
    "good_examples": [
      "Your style journey is uniquely yours. We're here to help you discover what makes you feel most like yourself.",
      "Quality pieces that stand the test of time—because your wardrobe should work as hard as you do.",
      "True style isn't about following every trend. It's about finding what resonates with who you are."
    ],
    "avoid_examples": [
      "Buy now! Limited time offer! Don't miss out!!!",
      "You NEED this in your wardrobe!",
      "Everyone is wearing this, so should you!",
      "Transform your style overnight with this one trick!"
